---
layout: null
---
{
"posts": [{% for post in site.posts %}
{"path":{{ post.path | jsonify }},"sourceSha":{{ post.source_sha | jsonify }},"title":{{ post.title | jsonify }},"quote":{{ post.quote | default: '' | jsonify }},"html":{{ post.content | jsonify }},"date":{{ post.date | date_to_xmlschema | jsonify }},"publishedAt":{{ post.published_at | jsonify }},"editedAt":{{ post.last_edited_at | jsonify }},"url":{{ post.url | relative_url | jsonify }},"kind":"post","references":{{ post.references | jsonify }},"referenceKey":{{ post.reference_key | jsonify }},"quoteReference":{{ post.quote_reference | jsonify }},"quoteLocator":{{ post.quote_locator | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}],
"pages": [{% assign entries = site.pages | where: 'layout', 'page' | where_exp: 'item', 'item.url != "/404.html"' %}{% for item in entries %}
{"path":{{ item.path | jsonify }},"sourceSha":{{ item.source_sha | jsonify }},"title":{{ item.title | jsonify }},"quote":{{ item.quote | default: '' | jsonify }},"html":{{ item.content | jsonify }},"date":{{ item.published_at | jsonify }},"publishedAt":{{ item.published_at | jsonify }},"editedAt":{{ item.last_edited_at | jsonify }},"url":{{ item.url | relative_url | jsonify }},"permalink":{{ item.url | jsonify }},"kind":"page","references":{{ item.references | jsonify }},"referenceKey":{{ item.reference_key | jsonify }},"quoteReference":{{ item.quote_reference | jsonify }},"quoteLocator":{{ item.quote_locator | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
}
